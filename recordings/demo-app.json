{
  "$schema": "../node_modules/testreel/recording-definition.schema.json",
  "url": "http://localhost:3000",
  "viewport": { "width": 1280, "height": 800 },
  "outputFormat": "mp4",
  "chrome": true,
  "cursor": { "enabled": true, "style": "default" },
  "speed": 1,
  "waitForSelector": "h1, main",
  "steps": [
    { "action": "wait", "ms": 1500 },
    { "action": "navigate", "url": "http://localhost:3000/ventas" },
    { "action": "wait", "ms": 1500 },
    { "action": "navigate", "url": "http://localhost:3000/catalogo" },
    { "action": "wait", "ms": 1500 },
    { "action": "navigate", "url": "http://localhost:3000/clientes" },
    { "action": "wait", "ms": 1500 },
    { "action": "navigate", "url": "http://localhost:3000/materiales" },
    { "action": "wait", "ms": 1500 },
    { "action": "navigate", "url": "http://localhost:3000/reportes" },
    { "action": "wait", "ms": 1500 },
    { "action": "navigate", "url": "http://localhost:3000/ventas/nueva" },
    { "action": "wait", "ms": 1500 },
    { "action": "navigate", "url": "http://localhost:3000/" },
    { "action": "wait", "ms": 1500 }
  ]
}
